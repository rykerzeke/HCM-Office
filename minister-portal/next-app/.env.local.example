# Fastify backend URL (the existing API server)
BACKEND_API_URL="http://localhost:4000/api"

# Supabase / Postgres connection string (for Drizzle-owned tables only)
# Get this from Supabase Dashboard → Project → Settings → Database → Connection String (use connection pooling)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[ref].supabase.co:6543/postgres?pgbouncer=true"
