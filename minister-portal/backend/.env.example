# Backend Environment Variables
# REQUIRED - Server will not start without these

# JWT signing secret — use a long random string in production
JWT_SECRET=your-strong-jwt-secret-min-32-chars

# 64-character hex string for AES-256-GCM encryption
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be exactly 64 hex characters — server exits on startup if wrong length
ENCRYPTION_KEY=your-64-char-hex-string-here

# Server port
PORT=4000

# PostgreSQL connection string (used at runtime by the API)
# Local dev:     postgresql://postgres:password@localhost:5432/hcm_portal
# Neon (cloud):  postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/hcm_portal?sslmode=require
# Supabase:      postgresql://postgres:[YOUR-PASSWORD]@db.[ref].supabase.co:5432/postgres?sslmode=require
# IMPORTANT: Cloud DBs require ?sslmode=require. For Supabase, set BOTH DATABASE_URL and DIRECT_URL.
DATABASE_URL="postgresql://postgres:password@localhost:5432/hcm_portal"

# Direct DB URL for migrations and seed (Prisma schema requires this)
# Supabase: use same as DATABASE_URL (direct port 5432). Neon: same as DATABASE_URL.
# LOCAL: leave unset or same as DATABASE_URL
# DIRECT_URL="postgresql://postgres:password@localhost:5432/hcm_portal"

# Allowed origins for CORS (comma-separated, no spaces)
# Production: https://hcm-portal.vercel.app
# Dev: http://localhost:5173
# REQUIRED on Render — if not set, only localhost:5173 is allowed (all prod requests will be blocked)
CORS_ORIGIN=http://localhost:5173

# Node environment
NODE_ENV=development

# Uploads directory path
# Local dev: leave blank (defaults to uploads/ relative to the compiled dist/ folder)
# Render production: /var/data/uploads  (MUST match the disk mountPath in render.yaml)
# UPLOADS_DIR=/var/data/uploads
