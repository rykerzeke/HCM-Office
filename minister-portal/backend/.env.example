# Backend Environment Variables
# REQUIRED - Server will not start without these

# JWT signing secret — use a long random string in production
JWT_SECRET=your-strong-jwt-secret-min-32-chars

# 64-character hex string for AES encryption
ENCRYPTION_KEY=your-64-char-hex-string-here

# Server port
PORT=4000

# PostgreSQL connection string
# Local dev:     postgresql://postgres:password@localhost:5432/hcm_portal
# Neon (cloud):  postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/hcm_portal?sslmode=require
# Supabase:      postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/hcm_portal"

# Allowed origins for CORS (comma-separated, no spaces)
# Production: https://hcm-portal.vercel.app
# Dev: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Node environment
NODE_ENV=development

# Uploads directory path
# Local dev: leave blank (defaults to ./uploads)
# Render production: /var/data/uploads  (must match the disk mount path in render.yaml)
# UPLOADS_DIR=/var/data/uploads
