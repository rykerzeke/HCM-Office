generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  ADMIN
  STAFF
  OFFICIAL
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments    Assignment[]
  comments       Comment[]
  auditLogs      AuditLog[]
  casesApproved  Case[]       @relation("ApprovedBy")
}

model Citizen {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  aadhaar   String?  // encrypted
  address   String?
  districtId String?
  stateId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  district  District? @relation(fields: [districtId], references: [id])
  state     State?    @relation(fields: [stateId], references: [id])
  cases     Case[]
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Minister Meeting Workflow statuses
enum CaseStatus {
  PENDING_APPROVAL   // 1. Request submitted
  APPROVED           // 2. Authorized for scheduling
  REJECTED
  ON_HOLD            // Clarification requested
  SCHEDULED          // 3. Date/time assigned
  COMPLETED          // 5/6. Meeting done
  CLOSED             // 6. Post-meeting closed
  NO_SHOW
  RESCHEDULED
  FOLLOW_UP_REQUIRED
  RESCHEDULE_REQUIRED
  // Legacy (keep for migration)
  PENDING
  IN_PROGRESS
  ESCALATED
  RESOLVED
  ARCHIVED
}

enum ReferringOfficer {
  VISHAL_GUPTA
  MAHENDRA_PRATAP_SINGH
  CHIRAG_PANCHAL
}

enum ReferenceMode {
  CALL
  EMAIL
  WRITTEN
  IN_PERSON
}

enum MeetingType {
  IN_PERSON
  VIRTUAL
}

enum VisitCheckIn {
  ARRIVED
  NO_SHOW
  RESCHEDULED
}

model Case {
  id             String    @id @default(uuid())
  caseId         String    @unique // Sequential MO-2026-00001
  citizenId      String
  purpose        String
  meetingDate    DateTime? // Legacy / preferred date
  status         CaseStatus @default(PENDING_APPROVAL)
  priority       Priority   @default(MEDIUM)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // 1. Request submission
  referringOfficer   ReferringOfficer?
  referenceMode      ReferenceMode?
  supportingNotePath String?

  // 2. Authorization
  rejectionReason    String?
  approvedAt         DateTime?
  approvedByUserId   String?
  approvedBy         User?       @relation("ApprovedBy", fields: [approvedByUserId], references: [id])

  // 3. Scheduling
  scheduledDate       DateTime?  // Date of meeting
  scheduledTimeSlot   String?    // e.g. "10:00-10:30"
  meetingType        MeetingType?
  venueOrLink        String?

  // 5. Visit day check-in
  visitCheckIn       VisitCheckIn?

  // 6. Post-meeting closure
  closureStatus      String?   // COMPLETED | FOLLOW_UP_REQUIRED | RESCHEDULE_REQUIRED
  closureNotes       String?

  citizen        Citizen    @relation(fields: [citizenId], references: [id])
  stakeholders   StakeholderMapping[]
  assignments    Assignment[]
  comments       Comment[]
  files          File[]
  auditLogs      AuditLog[]
}

model State {
  id        String   @id @default(uuid())
  name      String   @unique
  districts District[]
  officials Official[]
  citizens  Citizen[]
}

model District {
  id        String   @id @default(uuid())
  name      String
  stateId   String
  state     State    @relation(fields: [stateId], references: [id])
  officials Official[]
  citizens  Citizen[]
}

model Official {
  id          String   @id @default(uuid())
  name        String
  designation String
  department  String?
  contact     String?
  address     String?
  email       String?
  psName      String?
  districtId  String?
  stateId     String?

  district    District? @relation(fields: [districtId], references: [id])
  state       State?    @relation(fields: [stateId], references: [id])
  stakeholders StakeholderMapping[]
}

model StakeholderMapping {
  caseId     String
  officialId String

  case       Case      @relation(fields: [caseId], references: [id])
  official   Official  @relation(fields: [officialId], references: [id])

  @@id([caseId, officialId])
}

model Assignment {
  id        String   @id @default(uuid())
  caseId    String
  userId    String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case      Case     @relation(fields: [caseId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  imageUrl  String?
  caseId    String
  userId    String
  createdAt DateTime @default(now())

  case      Case     @relation(fields: [caseId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model File {
  id        String   @id @default(uuid())
  caseId    String
  filename  String
  path      String   // Path or URL to file
  mimetype  String
  size      Int
  createdAt DateTime @default(now())

  case      Case     @relation(fields: [caseId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  caseId    String?
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())

  case      Case?    @relation(fields: [caseId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}
