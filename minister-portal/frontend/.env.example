# Frontend Environment Variables
# Copy this to .env.local for local development
# For production (Vercel), set these in the Vercel dashboard

# Backend API base URL (must include /api suffix)
# Local dev:     http://localhost:4000/api
# Production:    https://your-backend.onrender.com/api  (replace with your Render URL)
VITE_API_URL=http://localhost:4000/api

# Optional: Supabase client (only if you use Supabase Auth/Realtime/Storage from the frontend)
# From Supabase: Project Settings → API → Project URL and anon/publishable key
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
